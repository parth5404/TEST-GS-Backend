# ─────────────────────────────────────────────────────────────────────────────
# Node API — environment variables
#
# Copy karke shuru kar:   cp .env.example .env
#
# `.env` gitignored hai. `.env.example` commit hoti hai, taaki koi bhi (tu, 6
# mahine baad) dekh sake ki chalane ke liye kya-kya chahiye. Abhi repo mein aisi
# koi file thi hi nahi — naye banda setup hi nahi kar sakta tha.
#
# Day 4 pe tu ek `config.js` likhega jo in sabko zod se boot pe validate karega,
# taaki missing variable turant crash kare — na ki pehle login pe 500 de.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# ── Database ─────────────────────────────────────────────────────────────────
# DOCKER ke andar se (compose khud ye set karta hai, yahan sirf reference ke liye):
#   mongodb://mongo:27017/gsacademia?replicaSet=rs0
#
# TERE LAPTOP se (mongosh / Compass / `npm run dev` bina docker ke):
#   ?directConnection=true ZARURI hai.
#
#   Kyun: replica set apne member ka address `mongo:27017` samajhta hai (wahi
#   naam compose network ke andar chalta hai). Tere laptop pe "mongo" hostname
#   resolve nahi hota, isliye driver topology discovery mein atak jaata hai aur
#   timeout de deta hai. directConnection=true discovery skip karke seedha
#   connect karta hai.
#
#   Ye exact jagah hai jahan log ghanton fasste hain. Yaad rakhna.
MONGO_URI=mongodb://localhost:27017/gsacademia?directConnection=true

# ── Auth ─────────────────────────────────────────────────────────────────────
# Lamba random string. Generate karne ke liye:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Site owner — createadmin route isse check karta hai.
# NOTE: middlewares/auth.js mein `adminAuthorization()` abhi ek email HARDCODE
# karta hai file ke andar. Ye Day 11 ke aas-paas theek hoga (role-based check).
SITE_OWNER_EMAIL=you@example.com

# ── Go email service ─────────────────────────────────────────────────────────
# Compose ise http://go-mail:8080 pe set karta hai (service ka naam = hostname).
# Bina docker ke chala raha hai toh localhost use kar.
#
# Day 5 ke baad ye variable HAT jayega — Node Go ko call karega hi nahi,
# dono Mongo ke outbox collection ke through baat karenge.
GO_SERVICE_URL=http://localhost:8080

# ── Frontend ─────────────────────────────────────────────────────────────────
# Password reset link isi URL se banta hai.
STUDY_NOTION_FRONTEND_SITE=http://localhost:3000

# ── Cloudinary (image/video uploads) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AVATAR_FOLDER_NAME=gsacademia/avatars
THUMBNAIL_FOLDER_NAME=gsacademia/thumbnails
VIDEO_FOLDER_NAME=gsacademia/videos

# Bytes mein. Code inhe seedha `avatar.size` se compare karta hai.
AVATAR_MAX_SIZE=1048576
THUMBNAIL_MAX_SIZE=2097152
VIDEO_MAX_SIZE=104857600

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Test mode keys use kar. Live keys kabhi local mein mat daal.
RAZORPAY_PAY_KEY_ID=
RAZORPAY_PAY_KEY_SECRET=

# Sirf commented-out webhook code isse use karta hai (PaymentC.js ke neeche).
RAZORPAY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# NEECHE WALE VARIABLES ABHI DEAD HAIN
#
# Code inhe padhta hai, par sirf commented-out nodemailer block ke andar
# (utils/emailSender.js). Asli mail Go service bhejti hai apne alag SMTP
# config se. Ye yahan isliye likhe hain taaki tujhe pata rahe ki ye zinda
# nahi hain — jab wo commented block delete karega, ye bhi hata dena.
# ─────────────────────────────────────────────────────────────────────────────
# MAIL_HOST=
# MAIL_USER=
# MAIL_PASS=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_EMAIL=
# SMTP_PASSWORD=
